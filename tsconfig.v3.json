{
  "extends": "./tsconfig.base.json",
  "vueCompilerOptions": {
    "target": 3
  },
  "compilerOptions": {
    "rootDir": "packages/components",
    "emitDeclarationOnly": true, // 仅生成声明文件
    "allowImportingTsExtensions": true,
    "declarationDir": "./dist/@vue-uni-ui/v3/types",
    "paths": {
      "@vue-uni-ui/utils": ["./dist/@vue-uni-ui/utils"],
      "~/*": ["./*"]
    }
  },
  // 包含的源文件
  "include": ["packages/components"],
  "exclude": [
    "dist",
    "**/__tests__/*",
    "**/*.test.*",
    "**/test-dts/*",
    "**/*.test-d.ts"
  ]
}
