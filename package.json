{
  "name": "vue-uni-component",
  "version": "0.0.1-beta.0",
  "private": true,
  "description": "",
  "packageManager": "pnpm@8.6.7",
  "scripts": {
    "dev:2": "pnpm -F ./containers/v2 dev",
    "dev:27": "pnpm -F ./containers/v2.7 dev",
    "dev:3": "pnpm -F ./containers/v3 dev",
    "dev:cdn": "pnpm -F ./cdn-playground dev",
    "build": "esno ./scripts/build.ts",
    "build:rollup": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" rollup --config=rollup.config.ts --configPlugin=rollup-plugin-esbuild",
    "ui:create": "esno ./scripts/components/create.ts",
    "ui:remove": "esno ./scripts/components/remove.ts",
    "release": "bumpp",
    "clean": "rimraf --glob ./**/dist ./**/node_modules",
    "test:2": "pnpm -F ./containers/v2 test",
    "test:27": "pnpm -F ./containers/v2.7 test",
    "test:3": "pnpm -F ./containers/v3 test"
  },
  "keywords": [
    "vue",
    "vue3",
    "frontend",
    "component-library",
    "components",
    "vue-components"
  ],
  "author": "ttse",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^20.4.5",
    "@types/prompts": "^2.4.4",
    "@vue/test-utils": "^2.4.5",
    "bumpp": "^9.1.1",
    "consola": "^3.2.3",
    "cross-env": "^7.0.3",
    "esbuild-register": "^3.4.2",
    "esno": "^0.17.0",
    "fast-glob": "^3.3.1",
    "fs-extra": "^11.1.1",
    "jsdom": "^23.0.1",
    "lodash-es": "^4.17.21",
    "prompts": "^2.4.2",
    "rimraf": "^5.0.1",
    "rollup": "^4.18.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "sass": "^1.65.1",
    "typescript": "^5.5.2",
    "vite": "^5.2.10",
    "vitest": "^1.1.0",
    "vue": "3.2.47",
    "vue-tsc": "^2.0.22",
    "vue2": "npm:vue@2.6.14",
    "vue27": "npm:vue@2.7.14"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "vue-demi": "^0.14.5"
  },
  "pnpm": {
    "packageExtensions": {
      "vue-template-compiler": {
        "peerDependencies": {
          "vue": "~2.6.14"
        }
      }
    },
    "overrides": {
      "vite": "^5.2.10"
    }
  }
}