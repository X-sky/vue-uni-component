{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "rootDir": "packages/components",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/components"],
  "exclude": [
    "dist",
    "**/__tests__/*",
    "**/*.test.*",
    "**/test-dts/*",
    "**/*.test-d.ts"
  ]
}
